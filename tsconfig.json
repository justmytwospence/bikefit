{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "node"],
    "noEmit": true,
    "strict": true,
    "allowJs": false,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "pipeline/**/*.ts", "vite.config.ts"]
}
